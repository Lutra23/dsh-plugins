{
  "name": "dsh-lens",
  "version": "0.1.0",
  "description": "内核透镜：把 app.asar 里的内核包变成可直读的工具——列文件、读文件、搜代码、对账版本，免去每次内核考古都手写 asar 解析器。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "test/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "asar",
    "kernel",
    "introspection"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
