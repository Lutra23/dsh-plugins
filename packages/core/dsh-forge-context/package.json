{
  "name": "@dsh-external/dsh-forge-context",
  "version": "0.0.9",
  "description": "Agent-authored context compaction for the DSH forge preset: the agent writes the summary, this plugin checks version/scope/protection, then commits through the official compaction path.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "check.cjs",
    "verify-dist.cjs",
    "SHARE-0.0.9.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc --noEmit false --emitDeclarationOnly",
    "probe:host": "node scripts/run-probe.mjs",
    "test": "node scripts/test.cjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-format-v3-to-v4": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lutra23/dsh-plugins.git",
    "directory": "packages/core/dsh-forge-context"
  }
}
