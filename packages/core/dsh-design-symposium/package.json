{
  "name": "dsh-design-symposium",
  "version": "0.5.0",
  "description": "设计研讨会插件：让多个持不同设计立场的贤者围绕同一议题多轮研讨，共享上下文，主席收敛为设计纪要（一致点/分歧/否决方案/建议决策/术语定名）。fork 自 HSM266/dsh-roundtable-harness，按 VCP MagiAgent 立场辩论哲学改造。Design-symposium plugin for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "HSM266 (original roundtable-harness) & MingYue workshop (symposium refactor)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HSM266/dsh-roundtable-harness.git"
  },
  "homepage": "https://github.com/HSM266/dsh-roundtable-harness#readme",
  "bugs": {
    "url": "https://github.com/HSM266/dsh-roundtable-harness/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "symposium",
    "design-review",
    "design-decision",
    "multi-agent",
    "magi-agent",
    "cost-meter",
    "设计研讨会",
    "立场辩论"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
