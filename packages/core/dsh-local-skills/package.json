  },
  "files": [
    "cordis.patch.yml",
    "lib/",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lutra23/dsh-plugins.git",
    "directory": "packages/core/dsh-local-skills"
